# PostgreSQL (Docker: docker compose up -d)
DATABASE_URL="postgresql://pokerroom:pokerroom_dev@127.0.0.1:5433/pokerroom?schema=public"

# SQLite (legacy — not used after Postgres switch):
# DATABASE_URL="file:./dev.db"

# openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_LONG_RANDOM_STRING"

# Public browser URL (socket CORS). Local:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Where the browser connects for Socket.io:
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
# Server-side URL to notify socket process (same as socket listen address):
SOCKET_SERVER_URL="http://127.0.0.1:3001"
SOCKET_PORT=3001
# Shared secret for Next → socket internal broadcast (any long random string):
SOCKET_INTERNAL_SECRET="CHANGE_ME_SOCKET_INTERNAL"

# Table worker: advances action clocks / showdown (run: npm run table-worker)
TABLE_WORKER_POLL_MS=350
TABLE_WORKER_CONCURRENCY=8
# Production: keep false and run table-worker. Dev: false is OK — GET /hand still advances while NODE_ENV=development.
TABLE_HAND_ADVANCE_ON_GET=false

# Browser hand poll (ms). Sockets trigger immediate refresh; these are backup intervals.
NEXT_PUBLIC_HAND_POLL_MS=2500
NEXT_PUBLIC_HAND_POLL_BACKGROUND_MS=6000


# Optional: create first admin on `npm run db:seed`
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
SEED_ADMIN_USERNAME="house_admin"
SEED_ADMIN_FIRST_NAME="House"
SEED_ADMIN_LAST_NAME="Admin"

# Cashier → Deposits: bank account players pay into, and where to send proof of payment (POP).
DEPOSIT_BANK_NAME="FNB"
DEPOSIT_ACCOUNT_NAME="Your Poker Room"
DEPOSIT_ACCOUNT_NUMBER="1234567890"
DEPOSIT_BRANCH_CODE="250655"
# Hint shown on the deposit screen (e.g. use your username as payment reference).
DEPOSIT_PAYMENT_REFERENCE_HINT="Use your username as the payment reference"
# At least one of email or phone is required for the deposit screen to show payment instructions.
DEPOSIT_POP_EMAIL="deposits@example.com"
DEPOSIT_POP_PHONE="+27 82 123 4567"
