{
  "name": "pokerroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,socket,worker,fleet -c blue,magenta,cyan,green \"next dev -p 3000\" \"tsx watch server/socket-server.ts\" \"tsx watch scripts/table-worker.ts\" \"tsx watch scripts/bot-fleet.ts\"",
    "dev:next": "next dev -p 3000",
    "dev:socket": "tsx watch server/socket-server.ts",
    "dev:worker": "tsx watch scripts/table-worker.ts",
    "table-worker": "tsx scripts/table-worker.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:prod": "concurrently -k -n next,socket,worker,fleet -c blue,magenta,cyan,green \"next start -p 3000\" \"npm run start:socket\" \"npm run start:worker\" \"npm run start:fleet\"",
    "start:socket": "tsx server/socket-server.ts",
    "start:worker": "tsx scripts/table-worker.ts",
    "start:fleet": "tsx scripts/bot-fleet.ts",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "bot": "tsx scripts/bot-runner.ts",
    "bot:fleet": "tsx scripts/bot-fleet.ts",
    "tournament:register-bots": "tsx scripts/tournament-register-bots.ts",
    "bot:train-cfr": "tsx scripts/cfr-train-hu.ts",
    "bot:train-cfr:hu": "tsx scripts/cfr-train-hu.ts",
    "bot:train-cfr:leduc": "tsx scripts/cfr-train-leduc.ts",
    "bot:train-cfr:push-fold": "tsx scripts/cfr-train-push-fold.ts",
    "bot:assess": "tsx scripts/assess-bravo.ts",
    "bot:assess:bravo": "tsx scripts/assess-bravo.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "pokersolver": "^2.1.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
