# Copy to the server as `.env` and replace every CHANGE_ME / yourdomain value.
# Generate secrets (run on server or locally):
#   openssl rand -base64 32

DATABASE_URL="postgresql://pokerroom:CHANGE_ME_DB_PASSWORD@127.0.0.1:5433/pokerroom?schema=public"

AUTH_SECRET="CHANGE_ME_AUTH_SECRET"
AUTH_URL="https://poker.yourdomain.com"

NEXT_PUBLIC_APP_URL="https://poker.yourdomain.com"
NEXT_PUBLIC_SOCKET_URL="https://socket.poker.yourdomain.com"
SOCKET_SERVER_URL="http://127.0.0.1:3001"
SOCKET_PORT=3001
SOCKET_INTERNAL_SECRET="CHANGE_ME_SOCKET_INTERNAL"

TABLE_WORKER_POLL_MS=350
TABLE_WORKER_CONCURRENCY=8
TABLE_HAND_ADVANCE_ON_GET=false

NEXT_PUBLIC_HAND_POLL_MS=2500
NEXT_PUBLIC_HAND_POLL_BACKGROUND_MS=6000

# One-time seed (remove or rotate after first deploy)
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"
SEED_ADMIN_USERNAME="house_admin"
SEED_ADMIN_FIRST_NAME="House"
SEED_ADMIN_LAST_NAME="Admin"
